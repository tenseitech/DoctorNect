  "cronJobs": [
    {
      "jobid": "1",
      "schedule": "0 * * * *",
      "command": "\n        UPDATE promoted_ads\n        SET status = 'expired',\n            updated_at = CURRENT_TIMESTAMP\n        WHERE status = 'active'\n          AND end_time <= CURRENT_TIMESTAMP;\n    ",
      "nodename": "localhost",
      "nodeport": 5432,
      "database": "postgres",
      "username": "postgres",
      "active": true
    },
    {
      "jobid": "2",
      "schedule": "0 3 * * *",
      "command": "\n        DELETE FROM otp_challenges\n        WHERE expires_at < CURRENT_TIMESTAMP - INTERVAL '1 day';\n\n        DELETE FROM otp_verification_sessions\n        WHERE expires_at < CURRENT_TIMESTAMP - INTERVAL '1 day';\n    ",
      "nodename": "localhost",
      "nodeport": 5432,
      "database": "postgres",
      "username": "postgres",
      "active": true
    },
    {
      "jobid": "3",
      "schedule": "15 3 * * *",
      "command": "\n        DELETE FROM abuse_rate_limits\n        WHERE window_start < CURRENT_TIMESTAMP - INTERVAL '7 days';\n    ",
      "nodename": "localhost",
      "nodeport": 5432,
      "database": "postgres",
      "username": "postgres",
      "active": true
    },
    {
      "jobid": "4",
      "schedule": "*/5 * * * *",
      "command": "SELECT public.expire_stale_ambulance_broadcasts();",
      "nodename": "localhost",
      "nodeport": 5432,
      "database": "postgres",
      "username": "postgres",
      "active": true
    }
  ],
