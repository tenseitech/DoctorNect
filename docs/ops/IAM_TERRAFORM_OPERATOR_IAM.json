{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformPassRoleDoctornectProduction",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/doctornect-production-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "TerraformIamCreateDoctornectProductionRoles",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/doctornect-production-*"
    },
    {
      "Sid": "TerraformIamCreateDoctornectProductionPolicies",
      "Effect": "Allow",
      "Action": "iam:CreatePolicy",
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/doctornect-production-*"
    },
    {
      "Sid": "TerraformIamDoctornectProductionRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies"
      ],
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/doctornect-production-*"
    },
    {
      "Sid": "TerraformIamDoctornectProductionPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/doctornect-production-*"
    },
    {
      "Sid": "TerraformIamReadOnly",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetPolicy",
        "iam:ListRoles",
        "iam:ListPolicies",
        "iam:ListPolicyVersions",
        "iam:SimulatePrincipalPolicy"
      ],
      "Resource": "*"
    }
  ]
}