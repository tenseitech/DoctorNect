# Flutter compile-time defines (--dart-define-from-file or per-key --dart-define)
# Public / restricted API keys only — never MSG91, Razorpay secrets, or service role keys.

APP_ENV=staging

# Staging Supabase client (APP_ENV=staging)
STAGING_SUPABASE_URL=https://your-project-ref.supabase.co
STAGING_SUPABASE_ANON_KEY=your-staging-anon-key

# Production client gateway (APP_ENV=production)
PROD_GATEWAY_URL=https://api.doctornect.com
PROD_GATEWAY_ANON_KEY=your-production-gateway-anon-key

# Supabase client when ENABLE_SUPABASE=1
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
ENABLE_SUPABASE=1
USE_SUPABASE_AUTH=false

# Postgres-only release: client must not use Firestore app paths (see firestore_forbidden_guard.dart)
# Pass as --dart-define FIRESTORE_FORBIDDEN=true (default in code is true when unset)
FIRESTORE_FORBIDDEN=true

# Ambulance module (Flutter): default off in release builds unless true/1/yes
AMBULANCE_ENABLED=false

USE_S3_STORAGE=true
FIREBASE_STORAGE_BUCKET=

FIREBASE_API_KEY_WEB=your_web_api_key_here
FIREBASE_API_KEY_ANDROID=your_android_api_key_here
FIREBASE_API_KEY_IOS=your_ios_api_key_here

RECAPTCHA_SITE_KEY=
APP_CHECK_DEBUG_TOKEN=
FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=
FIREBASE_APPCHECK_DEBUG_TOKEN=

ENABLE_DEMO_AUTH=false
ENABLE_DEMO_SUPER_ADMIN=false
