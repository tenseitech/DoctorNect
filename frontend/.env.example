# Optional storage bucket override (firebase_options.dart; defaults from APP_ENV)
FIREBASE_STORAGE_BUCKET=

# Firebase client configuration (public-safe identifiers only).
# These API keys are restricted in Google Cloud Console (HTTP referrers / app
# package + SHA-1 / bundle ID). They are NOT secret; never put MSG91, payment
# secrets, or service-account JSON here or in --dart-define.
FIREBASE_API_KEY_WEB=your_web_api_key_here
FIREBASE_API_KEY_ANDROID=your_android_api_key_here
FIREBASE_API_KEY_IOS=your_ios_api_key_here

# Optional App Check (web site key is public; secret key stays in Firebase Console)
RECAPTCHA_SITE_KEY=

# Optional local App Check debug UUID (not a production credential)
APP_CHECK_DEBUG_TOKEN=

# Supabase Client Configuration (when compiling with ENABLE_SUPABASE=1)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
USE_SUPABASE_AUTH=false
ENABLE_SUPABASE=0
USE_SUPABASE_DB_DOCTOR_PATIENT=false

# Demo authentication configuration (strictly local/staging only)
ENABLE_DEMO_AUTH=false
ENABLE_DEMO_SUPER_ADMIN=false

# S3 Presigned Storage override (default: false, resolves via Remote Config)
USE_S3_STORAGE=false

# MSG91 / Razorpay / service-account secrets belong ONLY in
# Cloud Functions (Secret Manager or functions/.secret.local for emulator).
# Never --dart-define them into the Flutter binary.
