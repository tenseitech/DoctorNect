          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests; script-src 'self' 'wasm-unsafe-eval' 'sha256-+M0fGRkOqgYlCQCff9oNQn6k6a7Si4Et8iofLMceadE=' https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://apis.google.com https://accounts.google.com https://checkout.razorpay.com https://cdn.razorpay.com; trusted-types flutterfire-firebase_core flutterfire-firebase_auth flutterfire-firebase_firestore flutterfire-firebase_functions flutterfire-firebase_storage flutterfire-firebase_messaging flutterfire-firebase_app_check; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.gstatic.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://lh3.googleusercontent.com https://*.googleusercontent.com https://www.gstatic.com https://*.google.com; frame-src 'self' blob: https://www.google.com https://www.recaptcha.net https://accounts.google.com https://medibond-45fad.firebaseapp.com https://api.razorpay.com https://checkout.razorpay.com; connect-src 'self' https: wss:;"
          }
        ]
      }
