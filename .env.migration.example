# ============================================================================
# DoctorNect: Supabase & Firebase Migration / Rollback Environment Config
# ============================================================================
# IMPORTANT: This file contains database credentials and API secrets.
# NEVER commit the real .env.migration to version control. It is gitignored.
# NEVER pass connection strings inline in PowerShell ($env:) or CLI arguments.
# ============================================================================

# Supabase Staging Database Connection (Read automatically by all scripts)
# Note: Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Pooler connection (recommended): postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Direct connection: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
STAGING_SUPABASE_DB_URL="postgresql://postgres.[PROJECT_REF]:[ROTATED_DB_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase URL & Service Role Key
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Firebase Admin Service Account Key path (optional if placed in scripts/service-account.json)
FIREBASE_SERVICE_ACCOUNT_PATH="./scripts/service-account.json"
FIREBASE_PROJECT_ID="medibond-45fad"

# Rollback dry-run test collection prefix (safety barrier so test reverse sync never touches production collections)
# When set, reverse sync writes to e.g. test_rollback_appointments instead of appointments
FIRESTORE_TEST_COLLECTION_PREFIX="test_rollback_"
