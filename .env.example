# =============================================================================
# DoctorNect — Master Environment & Compile Configuration Template (.env.example)
# =============================================================================
# IMPORTANT: NEVER commit real secret values, keys, or passwords to git.
# All `.env` and `*.secrets.dart` files are excluded in `.gitignore`.
# In production, Cloud Functions secrets must be stored in Google Cloud Secret Manager.
# =============================================================================

# Application Environment (staging | production)
APP_ENV=staging

# -----------------------------------------------------------------------------
# 1. FRONTEND COMPILE-TIME DEFINES (Injected via flutter run/build --dart-define)
# -----------------------------------------------------------------------------
# Staging Supabase Client Configuration (APP_ENV=staging)
STAGING_SUPABASE_URL=https://rnltknemwnjrjxthtull.supabase.co
STAGING_SUPABASE_ANON_KEY=your-staging-supabase-anon-key

# Production Access Layer Configuration (APP_ENV=production, PostgREST + Auth Gateway)
PROD_GATEWAY_URL=https://api.doctornect.com
PROD_GATEWAY_ANON_KEY=your-production-gateway-anon-key
# Cloud Functions → production PostgREST (service_role mint at gateway); never ship to Flutter client
PROD_GATEWAY_SERVICE_KEY=
# Auth Gateway: Firebase Admin checkRevoked after JWKS (requires ADC on ECS)
FIREBASE_REVOCATION_CHECK=true

USE_SUPABASE_AUTH=false

# Flutter compile: include Supabase client (--dart-define ENABLE_SUPABASE=1)
ENABLE_SUPABASE=1

# Optional override for firebase_options.dart storage bucket (defaults from APP_ENV)
FIREBASE_STORAGE_BUCKET=

# S3 Presigned Storage override (default: false, resolves via Remote Config)
USE_S3_STORAGE=false

# Firebase App Check Web reCAPTCHA v3 & Debug Attestation Token
FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=
FIREBASE_APPCHECK_DEBUG_TOKEN=
APP_CHECK_DEBUG_TOKEN=

# Platform-specific Firebase API Keys (optional overrides if not in firebase_options.secrets.dart)
FIREBASE_API_KEY_WEB=
FIREBASE_API_KEY_ANDROID=
FIREBASE_API_KEY_IOS=

# -----------------------------------------------------------------------------
# 2. BACKEND CLOUD FUNCTIONS CONFIGURATION (backend/functions/.env)
# -----------------------------------------------------------------------------
# MSG91 SMS Gateway (Stored in Secret Manager: MSG91_AUTH_KEY)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=DRNECT
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_ID_REGISTRATION=
MSG91_TEMPLATE_ID_LOGIN=
MSG91_TEMPLATE_ID_PASSWORD_RESET=
MSG91_FROM_EMAIL=no-reply@mail.doctornect.com
MSG91_EMAIL_DOMAIN=mail.doctornect.com
MSG91_PROXY_URL=
PROXY_SECRET=
VPC_CONNECTOR=

# Razorpay Payments (Server-side verification)
# production mein Secret Manager se bind hota hai
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# production mein Secret Manager se bind hota hai
RAZORPAY_WEBHOOK_SECRET=

# AWS S3 Storage (ap-south-1) — Presigned URL generation for clinical documents
# production mein Secret Manager se bind hota hai
AWS_ACCESS_KEY_ID=
# production mein Secret Manager se bind hota hai
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=doctornect
S3_URL_CACHE=off

# Redis / Memorystore (Fail-open cache for rate limits and presigned URLs)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true
OTP_REDIS_MIRROR=off
# Prefer redis in all deployed environments; firestore is legacy fallback only
RATE_LIMIT_BACKEND=redis

# Staging Supabase Database (rnltknemwnjrjxthtull)
STAGING_SUPABASE_URL=https://rnltknemwnjrjxthtull.supabase.co
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
# Session pooler (5432) or direct DB host — required for migrate.js / rls_sql_harness.js / anon_surface_audit.js (not :6543 transaction pooler)
STAGING_SUPABASE_DB_URL=postgresql://postgres.rnltknemwnjrjxthtull:****@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Production Amazon RDS PostgreSQL Database (Option A PostgREST / direct backend)
PROD_RDS_HOST=your-rds-endpoint.rds.amazonaws.com
PROD_RDS_PORT=5432
PROD_RDS_DB=postgres
PROD_RDS_USER=postgres
PROD_RDS_PASSWORD=
PROD_RDS_SSL_ROOT_CERT=infra/aws/global-bundle.pem
REPLAY_DB_URL=
ENABLE_SUPABASE_SYNC=0
# Emergency only: allow forward Firestore→Postgres sync bridge in production (default off)
FORCE_ENABLE_SUPABASE_SYNC_IN_PROD=0
# Staging-only reviewer/demo OTP bypass flags (must be empty in production)
ENABLE_REVIEW_DEMO=

# Security, Anti-Abuse, and App Check Enforcement
ENFORCE_OTP_APP_CHECK=true
ENFORCE_ABUSE_APP_CHECK=true
ENFORCE_AMBULANCE_HTTP_APP_CHECK=false
OTP_TEST_MODE=false
FIRESTORE_TRIGGER_REGION=asia-south2
# Production: block Cloud Functions Firestore app-data paths (OTP uses Redis)
FIRESTORE_FORBIDDEN=1
OTP_REDIS_MIRROR=on
# Auth Gateway CORS (comma-separated origins; no wildcard)
CORS_ALLOWED_ORIGINS=https://doctornect.com,https://www.doctornect.com,https://app.doctornect.com

# Administrative Allow-lists (Comma-separated emails)
ACCOUNT_APPROVAL_ADMIN_EMAILS=admin@doctornect.com
PATIENT_APPROVAL_ADMIN_EMAILS=admin@doctornect.com
BACKFILL_ADMIN_EMAILS=admin@doctornect.com

# Runtime cutover flag (false = Firestore primary, true = Supabase primary)
USE_SUPABASE_DB_DOCTOR_PATIENT=false
