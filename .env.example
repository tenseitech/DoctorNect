# =============================================================================
# DoctorNect — Master Environment & Compile Configuration Template (.env.example)
# =============================================================================
# IMPORTANT: NEVER commit real secret values, keys, or passwords to git.
# All `.env` and `*.secrets.dart` files are excluded in `.gitignore`.
# In production, Cloud Functions secrets must be stored in Google Cloud Secret Manager.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND COMPILE-TIME DEFINES (Injected via flutter run/build --dart-define)
# -----------------------------------------------------------------------------
# Supabase Client Configuration (Used when compiling with ENABLE_SUPABASE=1)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
USE_SUPABASE_AUTH=false

# Gating flag for release builds (0 = Firestore only, 1 = Enable Supabase mirror)
ENABLE_SUPABASE=1

# S3 Presigned Storage override (default: false, resolves via Remote Config)
USE_S3_STORAGE=false

# Firebase App Check Web reCAPTCHA v3 & Debug Attestation Token
FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=
FIREBASE_APPCHECK_DEBUG_TOKEN=
APP_CHECK_DEBUG_TOKEN=

# Platform-specific Firebase API Keys (optional overrides if not in firebase_options.secrets.dart)
FIREBASE_API_KEY_WEB=
FIREBASE_API_KEY_ANDROID=
FIREBASE_API_KEY_IOS=

# -----------------------------------------------------------------------------
# 2. BACKEND CLOUD FUNCTIONS CONFIGURATION (backend/functions/.env)
# -----------------------------------------------------------------------------
# MSG91 SMS Gateway (Stored in Secret Manager: MSG91_AUTHKEY)
MSG91_AUTHKEY=
MSG91_SENDER_ID=DRNECT
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_ID_REGISTRATION=
MSG91_TEMPLATE_ID_LOGIN=
MSG91_TEMPLATE_ID_PASSWORD_RESET=
MSG91_FROM_EMAIL=no-reply@mail.doctornect.com
MSG91_EMAIL_DOMAIN=mail.doctornect.com
MSG91_PROXY_URL=
PROXY_SECRET=
VPC_CONNECTOR=

# Razorpay Payments (Server-side verification)
# production mein Secret Manager se bind hota hai
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# production mein Secret Manager se bind hota hai
RAZORPAY_WEBHOOK_SECRET=

# AWS S3 Storage (ap-south-1) — Presigned URL generation for clinical documents
# production mein Secret Manager se bind hota hai
AWS_ACCESS_KEY_ID=
# production mein Secret Manager se bind hota hai
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=doctornect
S3_URL_CACHE=off

# Redis / Memorystore (Fail-open cache for rate limits and presigned URLs)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true
OTP_REDIS_MIRROR=off
RATE_LIMIT_BACKEND=firestore

# Supabase Server-Side Sync Bridge (Stored in Secret Manager in production)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ENABLE_SUPABASE_SYNC=0

# Security, Anti-Abuse, and App Check Enforcement
ENFORCE_OTP_APP_CHECK=true
ENFORCE_ABUSE_APP_CHECK=true
ENFORCE_AMBULANCE_HTTP_APP_CHECK=false
OTP_TEST_MODE=false
FIRESTORE_TRIGGER_REGION=asia-south2

# Administrative Allow-lists (Comma-separated emails)
ACCOUNT_APPROVAL_ADMIN_EMAILS=admin@doctornect.com
PATIENT_APPROVAL_ADMIN_EMAILS=admin@doctornect.com
BACKFILL_ADMIN_EMAILS=admin@doctornect.com

# Runtime cutover flag (false = Firestore primary, true = Supabase primary)
USE_SUPABASE_DB_DOCTOR_PATIENT=false
