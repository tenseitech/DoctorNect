# =============================================================================
# DoctorNect — environment template index (no secrets; no duplicate keys here)
# =============================================================================
# Copy real values only into gitignored files. Never commit `.env`, `.env.migration`,
# `backend/functions/.env`, or `frontend/lib/firebase_options.secrets.dart`.
#
# Canonical templates (one variable name per purpose):
#   frontend/.env.example          — Flutter --dart-define / public client config
#   backend/functions/.env.example — Cloud Functions runtime (non-secret flags + names)
#   backend/.env.migration.example — DB cutover, RDS replay, migration scripts only
#   .env.migration                 — local gitignored copy of migration template
#
# Production secrets: Google Cloud Secret Manager (+ `backend/functions/.secret.local` for emulator).
# See backend/functions/.env.example header for `firebase functions:secrets:set` names.
# =============================================================================
