# =============================================================================
# DoctorNect — single environment template (committed).
# Copy to gitignored `.env` at repo root. Real values never committed.
# =============================================================================

# --- APP_ENV — staging vs production routing (Functions, scripts, Flutter build) ---
APP_ENV=staging
SKIP_APP_ENV_DB_ASSERT=false

# --- Firebase (Admin scripts + client dart-defines) ---
# Flutter client builds REQUIRE (frontend/scripts/build_staging_demo_apk.ps1 and
# frontend/scripts/release_build.ps1/.sh stop and list any missing name):
#   FIREBASE_API_KEY_ANDROID  (Android app; FIREBASE_API_KEY_IOS for iOS, FIREBASE_API_KEY_WEB for web)
#   FIREBASE_PROJECT_ID       (must equal project_id in frontend/android/app/google-services.json)
# Client API keys are not secrets but MUST be restricted in Google Cloud console > APIs & Services >
# Credentials: Android key to package com.tenseitech.doctornect + your SHA-256 fingerprints,
# iOS key to the bundle id, web key to HTTP referrers; each only to the Firebase APIs it needs.
FIREBASE_PROJECT_ID=medibond-45fad
# Absolute path to an Admin SDK key stored OUTSIDE the repo (never inside scripts/ or .artifacts/).
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/outside/repo/service-account.json
FIREBASE_API_KEY_ANDROID=
FIREBASE_API_KEY_IOS=
FIREBASE_API_KEY_WEB=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=
FIREBASE_APPCHECK_DEBUG_TOKEN=
RECAPTCHA_SITE_KEY=
APP_CHECK_DEBUG_TOKEN=
GOOGLE_MAPS_API_KEY=

# --- Staging — Supabase Postgres ---
STAGING_SUPABASE_URL=https://your-project-ref.supabase.co
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
# Read-only audit role only — see docs/ops/STAGING_AUDIT_DATABASE.md
STAGING_SUPABASE_DB_URL=postgresql://doctornect_audit.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
DATABASE_URL=
# Direct pg pool tuning (Cloud Functions DLQ / reconciliation)
PG_POOL_MAX=10
PG_POOL_IDLE_MS=30000
PG_POOL_CONNECT_MS=10000
SUPABASE_WEBHOOK_SECRET=

# --- Production — AWS RDS (operator scripts; tunnel via RDS_PROD_TUNNEL_WINDOWS.md) ---
PROD_RDS_HOST=example-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
PROD_RDS_CONNECT_HOST=127.0.0.1
PROD_RDS_PORT=5433
PROD_RDS_DB=doctornect
# Least-privilege operator role (see db/rds_bootstrap/01_roles_and_extensions.sql). Never the RDS master / postgres.
PROD_RDS_USER=app_migrator
PROD_RDS_PASSWORD=
# RDS master credentials: one-off bootstrap only (db/rds_bootstrap). Prefer AWS Secrets Manager;
# never used by the app, gateway or Functions at runtime.
PROD_RDS_MASTER_USER=
PROD_RDS_MASTER_PASSWORD=
PROD_RDS_SSL_ROOT_CERT=infra/aws/global-bundle.pem
# Must be verify-full in production (require = no certificate check; Functions refuse it).
PROD_RDS_SSLMODE=verify-full
PROD_RDS_SSL_SERVERNAME=example-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
PROD_PG_MAJOR=18
PROD_PG_VERSION=18.3
REPLAY_PG_MAJOR=18
REPLAY_PG_DOCKER_TAG=18.3
LOCAL_REPLAY_PG_PORT=5440
REPLAY_DB_URL=postgresql://[USER]:[PASSWORD]@127.0.0.1:[PORT]/[DB]
LOCAL_FRESH_DB_URL=
FRESH_LOCAL_DB_NAME=

# --- Production — Auth Gateway + PostgREST ---
PROD_GATEWAY_URL=https://api.doctornect.com
# Gateway service key used by Cloud Functions. Production: Firebase Secret Manager only
# (scripts/ops/rotate_gateway_service_key.ps1); leave empty here.
PROD_GATEWAY_SERVICE_KEY=
PROD_GATEWAY_ANON_KEY=
PGRST_URL=http://127.0.0.1:3001
PGRST_JWT_SECRET=
PGRST_JWT_AUD=authenticated

# --- Demo → Supabase / Real → RDS (server-side only; single PROD_GATEWAY_URL for app) ---
DEMO_REAL_ROUTING_ENABLED=1
DEMO_FIREBASE_UID_ALLOWLIST=rev_fb_pat_001,rev_fb_doc_001,rev_fb_store_001,rev_fb_lab_001,rev_fb_amb_001
# Gateway dual-upstream: Supabase PostgREST base (often same host as DEMO_SUPABASE_URL + /rest/v1)
DEMO_PGRST_URL=
DEMO_PGRST_JWT_SECRET=
DEMO_PGRST_JWT_AUD=authenticated
DEMO_SUPABASE_URL=
# Service role key for the demo (staging) plane. Production: Firebase Secret (set_demo_secrets.ps1); leave empty here.
DEMO_SUPABASE_SERVICE_ROLE_KEY=
# 1 = treat any Firebase UID starting with demo_ as a demo account (keep 0 in production; use the allowlist).
DEMO_UID_PREFIX_ROUTING=0
# GitHub Actions backup only (repo secrets SUPABASE_KEEPALIVE_URL / SUPABASE_KEEPALIVE_KEY — not in .env for prod)
# SUPABASE_KEEPALIVE_URL=
# SUPABASE_KEEPALIVE_KEY=

# --- Client IP / rate limiting ---
# Number of trusted reverse proxies that APPEND to X-Forwarded-For. The client IP is the
# N-th entry from the right; anything further left is client-controlled and ignored.
#   Cloud Functions callables (Google Front End -> Cloud Run): 1
#   Function reached via a Firebase Hosting rewrite (Hosting CDN + GFE): 2
#   API gateway on ECS behind the AWS ALB: 1 (set on the ECS task); CloudFront -> ALB: 2
TRUSTED_PROXY_HOPS=1

# --- Redis ---
REDIS_HOST_STAGING=
REDIS_HOST_PRODUCTION=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true
REDIS_CA_CERT=
REDIS_CA_PATH=
OTP_REDIS_MIRROR=on
RATE_LIMIT_BACKEND=redis

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_STAGING=
S3_BUCKET_PRODUCTION=
S3_BUCKET=
S3_URL_CACHE=on
USE_S3_STORAGE=true

# --- MSG91 OTP ---
OTP_HMAC_SECRET=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_ID_REGISTRATION=
MSG91_TEMPLATE_ID_LOGIN=
MSG91_TEMPLATE_ID_PASSWORD_RESET=
MSG91_SENDER_ID=DRNECT
MSG91_FROM_EMAIL=no-reply@mail.doctornect.com
MSG91_EMAIL_DOMAIN=mail.doctornect.com
MSG91_PROXY_URL=
PROXY_SECRET=
MSG91_TEMPLATE_ID_APPROVAL=
MSG91_TEMPLATE_ID_REJECTION=
VPC_CONNECTOR=
ALLOW_LEGACY_UNSALTED_OTP_HASH=false
OTP_TEST_MODE=false
# App Check must stay true in production (production boot rejects false).
ENFORCE_OTP_APP_CHECK=true
ENFORCE_ABUSE_APP_CHECK=true

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay TEST-mode keys used ONLY for the five demo accounts (rzp_test_...). Secret Manager.
# Without them demo accounts cannot pay; they never get the live keys.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=

# --- Flutter client (dart-define — no server secrets) ---
ENABLE_SUPABASE=1
USE_SUPABASE_AUTH=false
USE_SUPABASE_DB_DOCTOR_PATIENT=
RUNTIME_DOCUMENT_DB_FORBIDDEN=1
# REQUIRED = 1. Firestore has been removed (Postgres: Supabase staging / RDS production).
# Cloud Functions refuse to boot with APP_ENV=production unless this is 1; also a Flutter dart-define.
FIRESTORE_FORBIDDEN=1
AMBULANCE_ENABLED=false
ENABLE_DEMO_AUTH=false
ENABLE_DEMO_SUPER_ADMIN=false
ENABLE_SUPABASE_SYNC=0
FORCE_ENABLE_SUPABASE_SYNC_IN_PROD=0
ENABLE_REVIEW_DEMO=

# --- Functions ops / review / admin ---
LEGACY_DOCUMENT_REGION=asia-south2
FIRESTORE_TRIGGER_REGION=asia-south2
# Optional: real Redis integration tests (docker -p 6390:6379 redis:7)
REDIS_INTEGRATION_URL=redis://127.0.0.1:6390
FORCE_REDIS_INTEGRATION=0
NOTIFICATION_DISPATCH_MODE=outbox
ENABLE_SUPABASE_DATABASE_WEBHOOK=0
DEMO_PHONE_PATIENT=
DEMO_PHONE_DOCTOR=
DEMO_PHONE_MEDICAL_STORE=
DEMO_PHONE_LAB=
DEMO_PHONE_AMBULANCE=
DEMO_PHONE_SUPER_ADMIN=
REVIEWER_OTP_ENABLED=true
REVIEW_ACCESS_UNTIL=2026-12-31T23:59:59.000Z
# Fixed reviewer OTP (6 digits). Production: Firebase Secret Manager only
# (functions:secrets:set REVIEW_FIXED_OTP); leave empty here. Bypass is off after REVIEW_ACCESS_UNTIL.
REVIEW_FIXED_OTP=
REVIEW_PATIENT_PHONES=9999900001
REVIEW_DOCTOR_PHONES=9999900002
REVIEW_MEDICAL_STORE_PHONES=9999900003
# Alias of REVIEW_MEDICAL_STORE_PHONES (either is accepted; use only fictitious numbers)
REVIEW_MEDICALSTORE_PHONES=
REVIEW_LAB_PHONES=9999900004
REVIEW_AMBULANCE_PHONES=9999900005
# Legacy fallback: maps 9999900001-0005 to roles when per-role REVIEW_*_PHONES are unset
REVIEW_TEST_NUMBERS=9999900001,9999900002,9999900003,9999900004,9999900005
# Staging-only: comma-separated 10-digit demo logins (skip MSG91 when APP_ENV!=production)
DEMO_PHONE_NUMBERS=
DEMO_FIXED_OTP=
ACCOUNT_APPROVAL_ADMIN_EMAILS=
PATIENT_APPROVAL_ADMIN_EMAILS=
BACKFILL_ADMIN_EMAILS=
ADMIN_CONSOLE_CORS_ORIGINS_STAGING=
ADMIN_CONSOLE_CORS_ORIGINS_PRODUCTION=
ADMIN_CONSOLE_CORS_ORIGINS=
ENFORCE_AMBULANCE_HTTP_APP_CHECK=false
AMBULANCE_HTTP_ALLOWED_ORIGINS=
FIRESTORE_TEST_COLLECTION_PREFIX=test_rollback_

# --- Other keys (union from legacy templates / local .env key names only) ---
ANON_KEY=
CORS_ALLOWED_ORIGINS=
FIREBASE_REVOCATION_CHECK=true
SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPER_ADMIN_EMAIL=
# Comma-separated super-admin emails (must also be email_verified + have the admin custom claim).
SUPER_ADMIN_EMAILS=
# Flutter dart-define for STAGING test APKs only (true = App Check debug provider; needs APP_ENV=staging).
# Never set for production; release scripts reject it. See docs/APP_CHECK_SETUP.md.
APP_CHECK_DEBUG_PROVIDER=
SUPER_ADMIN_PASSWORD=

