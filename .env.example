# =============================================================================
# DoctorNect — single environment template (committed).
# Copy to gitignored `.env` at repo root. Real values never committed.
# =============================================================================

# --- APP_ENV — staging vs production routing (Functions, scripts, Flutter build) ---
APP_ENV=staging
SKIP_APP_ENV_DB_ASSERT=your-skip-app-env-db-assert

# --- Firebase (Admin scripts + client dart-defines) ---
FIREBASE_PROJECT_ID=medibond-45fad
FIREBASE_SERVICE_ACCOUNT_PATH=./scripts/service-account.json
FIREBASE_API_KEY_ANDROID=your-firebase-api-key-android
FIREBASE_API_KEY_IOS=your-firebase-api-key-ios
FIREBASE_API_KEY_WEB=your-firebase-api-key-web
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=your-firebase-appcheck-recaptcha-site-key
FIREBASE_APPCHECK_DEBUG_TOKEN=your-firebase-appcheck-debug-token
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
APP_CHECK_DEBUG_TOKEN=your-app-check-debug-token
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Staging — Supabase Postgres ---
STAGING_SUPABASE_URL=https://your-project-ref.supabase.co
STAGING_SUPABASE_ANON_KEY=your-staging-anon-key
STAGING_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STAGING_SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret
SUPABASE_DB_URL=your-supabase-db-url
DATABASE_URL=your-database-url
SUPABASE_WEBHOOK_SECRET=your-secret

# --- Production — AWS RDS (operator scripts; tunnel via RDS_PROD_TUNNEL_WINDOWS.md) ---
PROD_RDS_HOST=example-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
PROD_RDS_CONNECT_HOST=127.0.0.1
PROD_RDS_PORT=5433
PROD_RDS_DB=doctornect
PROD_RDS_USER=postgres
PROD_RDS_PASSWORD=
PROD_RDS_SSL_ROOT_CERT=infra/aws/global-bundle.pem
PROD_RDS_SSLMODE=verify-full
PROD_RDS_SSL_SERVERNAME=example-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
REPLAY_DB_URL=postgresql://[USER]:[PASSWORD]@127.0.0.1:[PORT]/[DB]
LOCAL_REPLAY_PG_PORT=5440
LOCAL_FRESH_DB_URL=your-local-fresh-db-url
FRESH_LOCAL_DB_NAME=your-fresh-local-db-name

# --- Production — Auth Gateway + PostgREST ---
PROD_GATEWAY_URL=https://api.doctornect.com
PROD_GATEWAY_SERVICE_KEY=your-gateway-service-key
PROD_GATEWAY_ANON_KEY=your-production-gateway-anon-key
PGRST_URL=your-pgrst-url
PGRST_JWT_SECRET=your-secret
PGRST_JWT_AUD=your-pgrst-jwt-aud

# --- Redis ---
REDIS_HOST_STAGING=your-redis-host-staging
REDIS_HOST_PRODUCTION=your-redis-host-production
REDIS_HOST=your-redis-host
REDIS_PORT=your-redis-port
REDIS_PASSWORD=your-secret
REDIS_TLS=your-redis-tls
REDIS_CA_CERT=your-redis-ca-cert
REDIS_CA_PATH=your-redis-ca-path
OTP_REDIS_MIRROR=your-otp-redis-mirror
RATE_LIMIT_BACKEND=your-rate-limit-backend
OTP_HMAC_SECRET=your-secret

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=your-secret
AWS_SECRET_ACCESS_KEY=your-secret
AWS_REGION=your-aws-region
S3_BUCKET_STAGING=your-s3-bucket-staging
S3_BUCKET_PRODUCTION=your-s3-bucket-production
S3_BUCKET=your-s3-bucket
S3_URL_CACHE=your-s3-url-cache
USE_S3_STORAGE=your-use-s3-storage

# --- MSG91 OTP ---
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-template-id
MSG91_TEMPLATE_ID_REGISTRATION=your-template-id
MSG91_TEMPLATE_ID_LOGIN=your-template-id
MSG91_TEMPLATE_ID_PASSWORD_RESET=your-template-id
MSG91_SENDER_ID=your-msg91-sender-id
MSG91_FROM_EMAIL=your-msg91-from-email
MSG91_EMAIL_DOMAIN=your-msg91-email-domain
MSG91_PROXY_URL=your-msg91-proxy-url
PROXY_SECRET=your-secret
MSG91_TEMPLATE_ID_APPROVAL=your-template-id
MSG91_TEMPLATE_ID_REJECTION=your-template-id
VPC_CONNECTOR=your-vpc-connector
ALLOW_LEGACY_UNSALTED_OTP_HASH=your-allow-legacy-unsalted-otp-hash
OTP_TEST_MODE=your-otp-test-mode
ENFORCE_OTP_APP_CHECK=your-enforce-otp-app-check
ENFORCE_ABUSE_APP_CHECK=your-enforce-abuse-app-check

# --- Razorpay ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-secret
RAZORPAY_WEBHOOK_SECRET=your-secret

# --- Flutter client (dart-define — no server secrets) ---
ENABLE_SUPABASE=your-enable-supabase
USE_SUPABASE_AUTH=your-use-supabase-auth
USE_SUPABASE_DB_DOCTOR_PATIENT=your-use-supabase-db-doctor-patient
AMBULANCE_ENABLED=your-ambulance-enabled
ENABLE_DEMO_AUTH=your-enable-demo-auth
ENABLE_DEMO_SUPER_ADMIN=your-enable-demo-super-admin
ENABLE_SUPABASE_SYNC=your-enable-supabase-sync
FORCE_ENABLE_SUPABASE_SYNC_IN_PROD=your-force-enable-supabase-sync-in-prod
ENABLE_REVIEW_DEMO=your-enable-review-demo

# --- Functions ops / review / admin ---
FIRESTORE_FORBIDDEN=1
FIRESTORE_TRIGGER_REGION=your-firestore-trigger-region
NOTIFICATION_DISPATCH_MODE=your-notification-dispatch-mode
DEMO_PHONE_PATIENT=your-demo-phone-patient
DEMO_PHONE_DOCTOR=your-demo-phone-doctor
DEMO_PHONE_MEDICAL_STORE=your-demo-phone-medical-store
DEMO_PHONE_LAB=your-demo-phone-lab
DEMO_PHONE_AMBULANCE=your-demo-phone-ambulance
DEMO_PHONE_SUPER_ADMIN=your-demo-phone-super-admin
REVIEWER_OTP_ENABLED=your-reviewer-otp-enabled
REVIEW_ACCESS_UNTIL=your-review-access-until
REVIEW_FIXED_OTP=your-review-fixed-otp
REVIEW_PATIENT_PHONES=your-review-patient-phones
REVIEW_DOCTOR_PHONES=your-review-doctor-phones
REVIEW_LAB_PHONES=your-review-lab-phones
REVIEW_MEDICAL_STORE_PHONES=your-review-medical-store-phones
REVIEW_AMBULANCE_PHONES=your-review-ambulance-phones
ACCOUNT_APPROVAL_ADMIN_EMAILS=your-account-approval-admin-emails
PATIENT_APPROVAL_ADMIN_EMAILS=your-patient-approval-admin-emails
BACKFILL_ADMIN_EMAILS=your-backfill-admin-emails
ADMIN_CONSOLE_CORS_ORIGINS_STAGING=your-admin-console-cors-origins-staging
ADMIN_CONSOLE_CORS_ORIGINS_PRODUCTION=your-admin-console-cors-origins-production
ADMIN_CONSOLE_CORS_ORIGINS=your-admin-console-cors-origins
ENFORCE_AMBULANCE_HTTP_APP_CHECK=your-enforce-ambulance-http-app-check
AMBULANCE_HTTP_ALLOWED_ORIGINS=your-ambulance-http-allowed-origins
FIRESTORE_TEST_COLLECTION_PREFIX=your-firestore-test-collection-prefix

# --- Other keys (union from legacy templates / local .env key names only) ---
ANON_KEY=your-anon-key
CORS_ALLOWED_ORIGINS=your-cors-allowed-origins
ENABLE_SUPABASE_DATABASE_WEBHOOK=your-enable-supabase-database-webhook
FIREBASE_REVOCATION_CHECK=your-firebase-revocation-check
PROD_PG_MAJOR=your-prod-pg-major
PROD_PG_VERSION=your-prod-pg-version
REPLAY_PG_DOCKER_TAG=your-replay-pg-docker-tag
REPLAY_PG_MAJOR=your-replay-pg-major
