# =============================================================================
# DoctorNect — single environment template (committed).
# Copy to gitignored `.env` at repo root. Real values never committed.
# =============================================================================

# --- APP_ENV — staging vs production routing (Functions, scripts, Flutter build) ---
APP_ENV=staging
SKIP_APP_ENV_DB_ASSERT=false

# --- Firebase (Admin scripts + client dart-defines) ---
FIREBASE_PROJECT_ID=medibond-45fad
FIREBASE_SERVICE_ACCOUNT_PATH=./scripts/service-account.json
FIREBASE_API_KEY_ANDROID=your_android_api_key_here
FIREBASE_API_KEY_IOS=your_ios_api_key_here
FIREBASE_API_KEY_WEB=your_web_api_key_here
FIREBASE_STORAGE_BUCKET=
FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=
FIREBASE_APPCHECK_DEBUG_TOKEN=
RECAPTCHA_SITE_KEY=
APP_CHECK_DEBUG_TOKEN=
GOOGLE_MAPS_API_KEY=

# --- Staging — Supabase Postgres ---
STAGING_SUPABASE_URL=https://your-project-ref.supabase.co
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
DATABASE_URL=
SUPABASE_WEBHOOK_SECRET=

# --- Production — AWS RDS (operator scripts; tunnel via RDS_PROD_TUNNEL_WINDOWS.md) ---
PROD_RDS_HOST=your-db.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
PROD_RDS_CONNECT_HOST=127.0.0.1
# Required for production RDS scripts (tunnel local port; not optional — no default 5432)
PROD_RDS_PORT=5433
PROD_RDS_DB=doctornect
PROD_RDS_USER=postgres
PROD_RDS_PASSWORD=
PROD_RDS_SSL_ROOT_CERT=infra/aws/global-bundle.pem
PROD_RDS_SSLMODE=verify-full
PROD_RDS_SSL_SERVERNAME=your-db.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
# Production RDS engine major (asserted by rds_readiness_probe / production smoke)
PROD_PG_MAJOR=18
# Documented production RDS full version (minor enforced on production RDS probes)
PROD_PG_VERSION=18.3
# Local throwaway replay (Docker postgres:18.3 on 5440 — never 5432/5433 tunnel ports)
REPLAY_PG_MAJOR=18
REPLAY_PG_DOCKER_TAG=18.3
LOCAL_REPLAY_PG_PORT=5440
REPLAY_DB_URL=postgresql://[USER]:[PASSWORD]@127.0.0.1:[PORT]/[DB]
LOCAL_FRESH_DB_URL=
FRESH_LOCAL_DB_NAME=

# --- Production — Auth Gateway + PostgREST ---
PROD_GATEWAY_URL=https://api.doctornect.com
PROD_GATEWAY_SERVICE_KEY=
PROD_GATEWAY_ANON_KEY=
PGRST_URL=http://127.0.0.1:3001
PGRST_JWT_SECRET=
PGRST_JWT_AUD=authenticated

# --- Redis ---
REDIS_HOST_STAGING=
REDIS_HOST_PRODUCTION=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true
REDIS_CA_CERT=
REDIS_CA_PATH=
OTP_REDIS_MIRROR=on
RATE_LIMIT_BACKEND=redis

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_STAGING=
S3_BUCKET_PRODUCTION=
S3_BUCKET=
S3_URL_CACHE=on
USE_S3_STORAGE=true

# --- MSG91 OTP ---
# HMAC secret for OTP hashing (required in production; takes priority over MSG91 key)
OTP_HMAC_SECRET=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_ID_REGISTRATION=
MSG91_TEMPLATE_ID_LOGIN=
MSG91_TEMPLATE_ID_PASSWORD_RESET=
MSG91_SENDER_ID=DRNECT
MSG91_FROM_EMAIL=no-reply@mail.doctornect.com
MSG91_EMAIL_DOMAIN=mail.doctornect.com
MSG91_PROXY_URL=
PROXY_SECRET=
MSG91_TEMPLATE_ID_APPROVAL=
MSG91_TEMPLATE_ID_REJECTION=
VPC_CONNECTOR=
ALLOW_LEGACY_UNSALTED_OTP_HASH=false
OTP_TEST_MODE=false
ENFORCE_OTP_APP_CHECK=false
ENFORCE_ABUSE_APP_CHECK=true

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Flutter client (dart-define — no server secrets) ---
ENABLE_SUPABASE=1
USE_SUPABASE_AUTH=false
USE_SUPABASE_DB_DOCTOR_PATIENT=
FIRESTORE_FORBIDDEN=1
AMBULANCE_ENABLED=false
ENABLE_DEMO_AUTH=false
ENABLE_DEMO_SUPER_ADMIN=false
ENABLE_SUPABASE_SYNC=0
FORCE_ENABLE_SUPABASE_SYNC_IN_PROD=0
ENABLE_REVIEW_DEMO=

# --- Functions ops / review / admin ---
FIRESTORE_TRIGGER_REGION=asia-south2
NOTIFICATION_DISPATCH_MODE=outbox
# Legacy Supabase Dashboard → HTTPS webhook (staging only). Production uses notification_outbox worker.
ENABLE_SUPABASE_DATABASE_WEBHOOK=0
DEMO_PHONE_PATIENT=
DEMO_PHONE_DOCTOR=
DEMO_PHONE_MEDICAL_STORE=
DEMO_PHONE_LAB=
DEMO_PHONE_AMBULANCE=
DEMO_PHONE_SUPER_ADMIN=
REVIEWER_OTP_ENABLED=false
REVIEW_ACCESS_UNTIL=
REVIEW_FIXED_OTP=
REVIEW_PATIENT_PHONES=
REVIEW_DOCTOR_PHONES=
REVIEW_LAB_PHONES=
REVIEW_MEDICAL_STORE_PHONES=
REVIEW_AMBULANCE_PHONES=
ACCOUNT_APPROVAL_ADMIN_EMAILS=
PATIENT_APPROVAL_ADMIN_EMAILS=
BACKFILL_ADMIN_EMAILS=
ADMIN_CONSOLE_CORS_ORIGINS_STAGING=
ADMIN_CONSOLE_CORS_ORIGINS_PRODUCTION=
ADMIN_CONSOLE_CORS_ORIGINS=
ENFORCE_AMBULANCE_HTTP_APP_CHECK=false
AMBULANCE_HTTP_ALLOWED_ORIGINS=
FIRESTORE_TEST_COLLECTION_PREFIX=test_rollback_

# --- Other keys (from legacy templates / local .env) ---
ANON_KEY=
CORS_ALLOWED_ORIGINS=
FIREBASE_REVOCATION_CHECK=
REVIEW_TEST_NUMBERS=
SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

