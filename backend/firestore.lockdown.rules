rules_version = '2';

// DoctorNect: Clean Launch Lockdown Rules
// Zero client reads or writes are permitted to Cloud Firestore.
// Supabase PostgreSQL is the sole primary database for all 5 modules.
// Admin SDK / Cloud Functions bypass these rules automatically.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
