# =============================================================================
# Cloud Functions secrets — NEVER commit real values.
# =============================================================================
# Production (required): store in Google Secret Manager and bind via secure_config.js
#
#   firebase functions:secrets:set MSG91_AUTH_KEY
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#
# Local emulator: copy secret VALUES into `.secret.local` (gitignored), one per line:
#   MSG91_AUTH_KEY=...
#   RAZORPAY_KEY_ID=...
# Non-secret flags can stay in this `.env` file (also gitignored).
#
# `.env` is excluded from `firebase deploy` via firebase.json functions.ignore.
# Never put MSG91 / Razorpay secrets in Flutter --dart-define or lib/.

# OTP / App Check
# NEVER enable OTP_TEST_MODE or DEMO_PHONE_* on production project medibond-45fad.
OTP_TEST_MODE=false
# Set false until Play Integrity (Android) + reCAPTCHA (web) are live in Firebase Console.
ENFORCE_OTP_APP_CHECK=true
ENFORCE_ABUSE_APP_CHECK=true
# Ambulance web login HTTP fallback (verifyAmbulanceDriverLoginHttp).
# Keep false until web client ships X-Firebase-AppCheck on that fetch call.
ENFORCE_AMBULANCE_HTTP_APP_CHECK=false
# Extra CORS origins (comma-separated), e.g. http://localhost:5000 for local Flutter web.
AMBULANCE_HTTP_ALLOWED_ORIGINS=

# Demo / store-review accounts (server-only). One mobile per role; OTP is always 000000, no SMS.
# Leave blank in production — functions refuse to boot if set on medibond-45fad.
DEMO_PHONE_PATIENT=
DEMO_PHONE_DOCTOR=9999900002
DEMO_PHONE_MEDICAL_STORE=
DEMO_PHONE_LAB=
DEMO_PHONE_AMBULANCE=
DEMO_PHONE_SUPER_ADMIN=
# Legacy alias for patient demo number:
GOOGLE_PLAY_REVIEW_PHONE=
# App Store Review bypass window (ISO string / test numbers / fixed OTP):
REVIEW_ACCESS_UNTIL=
REVIEW_FIXED_OTP=
REVIEW_TEST_NUMBERS=

# MSG91 (SMS) — server-side only (prefer Secret Manager / .secret.local)
MSG91_AUTH_KEY=
# Legacy aliases still read by server if MSG91_AUTH_KEY unset: MSG91_AUTHKEY, AUTH_KEY
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_ID_REGISTRATION=
MSG91_TEMPLATE_ID_LOGIN=
MSG91_TEMPLATE_ID_PASSWORD_RESET=
MSG91_SENDER_ID=DRNECT
MSG91_FROM_EMAIL=no-reply@mail.doctornect.com
MSG91_EMAIL_DOMAIN=mail.doctornect.com
MSG91_PROXY_URL=
PROXY_SECRET=
MSG91_TEMPLATE_ID_APPROVAL=
MSG91_TEMPLATE_ID_REJECTION=
VPC_CONNECTOR=
ALLOW_LEGACY_UNSALTED_OTP_HASH=false

# Admin allow-lists (comma-separated emails — not secrets, but keep out of client)
ACCOUNT_APPROVAL_ADMIN_EMAILS=
PATIENT_APPROVAL_ADMIN_EMAILS=
BACKFILL_ADMIN_EMAILS=

# Payments (optional — set when Razorpay goes live)
# production mein Secret Manager se bind hota hai
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# production mein Secret Manager se bind hota hai
RAZORPAY_WEBHOOK_SECRET=

# AWS S3 Storage (ap-south-1) — presigned object storage for clinical documents
# production mein Secret Manager se bind hota hai
AWS_ACCESS_KEY_ID=
# production mein Secret Manager se bind hota hai
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=doctornect-672027759702-ap-south-1-an
S3_BUCKET_NAME=doctornect-672027759702-ap-south-1-an
AWS_S3_VAULT_BUCKET=doctornect-672027759702-ap-south-1-an
S3_URL_CACHE=on
USE_S3_STORAGE=true

# Firestore trigger region must match the Firestore database location.
FIRESTORE_TRIGGER_REGION=asia-south2
FIRESTORE_FORBIDDEN=0

# Redis / Redis Cloud (DRNECT-DB)
# Production uses: firebase functions:secrets:set REDIS_HOST / REDIS_PORT / REDIS_PASSWORD
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true
REDIS_CA_CERT=
REDIS_CA_PATH=
# OTP Redis mirror caches OTP challenges with 900s TTL.
OTP_REDIS_MIRROR=on
RATE_LIMIT_BACKEND=redis

# Production access layer (APP_ENV=production) — Cloud Functions use gateway, not direct Supabase URL
APP_ENV=staging
PROD_GATEWAY_URL=
PROD_GATEWAY_SERVICE_KEY=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SERVICE_ROLE_KEY=

# Supabase (DRNECT-DB — optional, server-only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_DB_URL=
# Legacy aliases still read by server if SUPABASE_SERVICE_ROLE_KEY unset: SUPABASE_SECRET_KEY, SUPABASE_SERVICE_KEY
# Gating flag for Firestore -> Supabase background triggers (keep 0 in Firestore-only release):
ENABLE_SUPABASE_SYNC=0
FORCE_ENABLE_SUPABASE_SYNC_IN_PROD=0
ENABLE_REVIEW_DEMO=
# Shared secret for Supabase Database Webhooks calling Cloud Function HTTPS endpoints:
SUPABASE_WEBHOOK_SECRET=

# FCM dispatch: outbox (default, RDS/staging SQL triggers) or webhook (legacy HTTPS tests only).
NOTIFICATION_DISPATCH_MODE=outbox

# Runtime cutover flag (0 = Firestore primary, 1 = Supabase primary)
USE_SUPABASE_DB_DOCTOR_PATIENT=1
