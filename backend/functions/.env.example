# =============================================================================
# Cloud Functions — runtime template (gitignored `.env` + Secret Manager in prod)
# =============================================================================
# Secrets: firebase functions:secrets:set MSG91_AUTH_KEY (see secure_config.js / index.js bindings)
# Emulator secrets: copy VALUES to `.secret.local` (gitignored), not this file.
# =============================================================================

APP_ENV=staging

# OTP / App Check (NEVER enable OTP_TEST_MODE or DEMO_PHONE_* on medibond-45fad)
OTP_TEST_MODE=false
ENFORCE_OTP_APP_CHECK=true
ENFORCE_ABUSE_APP_CHECK=true
ENFORCE_AMBULANCE_HTTP_APP_CHECK=false
AMBULANCE_HTTP_ALLOWED_ORIGINS=

# Demo / store-review (server-only; blank in production)
DEMO_PHONE_PATIENT=
DEMO_PHONE_DOCTOR=
DEMO_PHONE_MEDICAL_STORE=
DEMO_PHONE_LAB=
DEMO_PHONE_AMBULANCE=
DEMO_PHONE_SUPER_ADMIN=
REVIEW_ACCESS_UNTIL=
REVIEW_FIXED_OTP=
REVIEW_TEST_NUMBERS=

# MSG91 — prefer Secret Manager / .secret.local (legacy alias: MSG91_AUTHKEY)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_ID_REGISTRATION=
MSG91_TEMPLATE_ID_LOGIN=
MSG91_TEMPLATE_ID_PASSWORD_RESET=
MSG91_SENDER_ID=DRNECT
MSG91_FROM_EMAIL=no-reply@mail.doctornect.com
MSG91_EMAIL_DOMAIN=mail.doctornect.com
MSG91_PROXY_URL=
PROXY_SECRET=
MSG91_TEMPLATE_ID_APPROVAL=
MSG91_TEMPLATE_ID_REJECTION=
VPC_CONNECTOR=
ALLOW_LEGACY_UNSALTED_OTP_HASH=false

ACCOUNT_APPROVAL_ADMIN_EMAILS=
PATIENT_APPROVAL_ADMIN_EMAILS=
BACKFILL_ADMIN_EMAILS=

# Razorpay — Secret Manager in production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AWS S3 — Secret Manager in production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=your-s3-vault-bucket
S3_URL_CACHE=on
USE_S3_STORAGE=true

FIRESTORE_TRIGGER_REGION=asia-south2
# Postgres-only release: block Firestore app-data paths in Functions
FIRESTORE_FORBIDDEN=1

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true
REDIS_CA_CERT=
REDIS_CA_PATH=
OTP_REDIS_MIRROR=on
RATE_LIMIT_BACKEND=redis

# Staging DB (APP_ENV=staging) — production uses PROD_GATEWAY_* below
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SERVICE_ROLE_KEY=

# Production access layer (APP_ENV=production)
PROD_GATEWAY_URL=
PROD_GATEWAY_SERVICE_KEY=

# Optional direct Supabase REST (local/staging diagnostics; not Flutter client)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
DATABASE_URL=
SUPABASE_WEBHOOK_SECRET=

ENABLE_SUPABASE_SYNC=0
FORCE_ENABLE_SUPABASE_SYNC_IN_PROD=0
ENABLE_REVIEW_DEMO=

NOTIFICATION_DISPATCH_MODE=outbox

# Fallback if Remote Config unreachable (isDoctorPatientSupabasePrimary() is true in postgres-only code)
USE_SUPABASE_DB_DOCTOR_PATIENT=1
