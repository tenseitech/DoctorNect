{
  "name": "medibond-functions",
  "description": "Medibond Cloud Functions — ambulance push notifications",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2"
  },
  "overrides": {
    "gaxios": "^7.3.1",
    "uuid": "^11.1.0",
    "@grpc/grpc-js": "^1.14.5"
  },
  "scripts": {
    "build": "node --check index.js src/config/redis.js redis.js",
    "deploy": "firebase deploy --only firestore:rules,storage,functions",
    "test": "node --test test/**/*.test.js",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage --project demo-doctornect-kyc \"node --test test/storage_doctor_kyc.rules.test.js test/storage_provider_kyc.rules.test.js\"",
    "test:firestore-rules": "firebase emulators:exec --only firestore --project demo-doctornect-reviews \"node --test test/firestore_reviews.rules.test.js\"",
    "test:firestore-s3-rules": "firebase emulators:exec --only firestore --project demo-doctornect-s3-rules \"node --test test/firestore_s3_rules.test.js\"",
    "test:promoted-ads": "firebase emulators:exec --only firestore --project demo-doctornect-promoted-rules \"node --test test/promoted_ads_verification.test.js\""
  },
  "private": true
}
