{
  "name": "medibond-functions",
  "description": "DoctorNect Cloud Functions (Postgres + Redis + S3; Firebase Auth only)",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@supabase/supabase-js": "^2.117.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2",
    "ioredis": "^6.0.0"
  },
  "overrides": {
    "gaxios": "^7.3.1",
    "uuid": "^11.1.0",
    "@grpc/grpc-js": "^1.14.5",
    "@fastify/busboy": "^3.2.2",
    "minimatch": "^11.0.3",
    "glob": "^14.0.3",
    "rimraf": "^6.1.3"
  },
  "scripts": {
    "build": "node --check index.js src/config/redis.js redis.js",
    "deploy": "firebase deploy --only storage,functions",
    "test": "node --require ./test/setup_env.js --test \"test/**/*.test.js\"",
    "test:env-parity": "node --require ./test/setup_env.js --test test/env_parity.test.js"
  },
  "private": true
}
