# ============================================================================
# DoctorNect: migration / infra / RDS replay (NOT loaded by Cloud Functions deploy)
# ============================================================================
# Copy to gitignored `.env.migration` at repo root. Used by scripts under scripts/db/,
# scripts/ops/, and one-off cutover tools — not by firebase deploy of functions.
# NEVER commit real credentials. Names only in git; values from your password manager.
# ============================================================================

APP_ENV=staging

# --- Staging Supabase (logical backup, migrate, anon audit, seed scripts) ---
STAGING_SUPABASE_URL=https://your-project-ref.supabase.co
STAGING_SUPABASE_ANON_KEY=your-staging-anon-key
STAGING_SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
# Session pooler (5432) — required for migrate.js / rls harness (not :6543 transaction pooler)
STAGING_SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Production RDS replay / verification (scripts only) ---
PROD_RDS_HOST=your-rds-endpoint.rds.amazonaws.com
PROD_RDS_PORT=5432
PROD_RDS_DB=postgres
PROD_RDS_USER=postgres
PROD_RDS_PASSWORD=
PROD_RDS_SSL_ROOT_CERT=infra/aws/global-bundle.pem
REPLAY_DB_URL=

# --- Firebase Admin (migration scripts) ---
FIREBASE_SERVICE_ACCOUNT_PATH=./scripts/service-account.json
FIREBASE_PROJECT_ID=medibond-45fad

# --- Rollback dry-run collection prefix ---
FIRESTORE_TEST_COLLECTION_PREFIX=test_rollback_

# Legacy aliases used by some scripts (prefer STAGING_* / SUPABASE_SERVICE_ROLE_KEY above)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
