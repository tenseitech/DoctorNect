# Copy to terraform.tfvars (gitignored). No secret values in this file.

aws_region  = "ap-south-1"
environment = "production"
project_name = "doctornect"

# --- Existing VPC / networking (console-created) ---
vpc_id = "vpc-xxxxxxxx"
public_subnet_ids  = ["subnet-public-a", "subnet-public-b"]
private_subnet_ids = ["subnet-private-a", "subnet-private-b"]

# Public-subnet Fargate (no NAT): ECS uses public_subnet_ids + public IP
ecs_assign_public_ip = true
ecs_desired_count    = 0
enable_waf           = false

# --- DNS / TLS (manual ACM + optional Route53) ---
domain_name           = "api.doctornect.com"
acm_certificate_arn   = "arn:aws:acm:ap-south-1:ACCOUNT_ID:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- Container images: set by infra/aws/build_push_images.ps1 (immutable tags, never :latest) ---
gateway_image   = "ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/doctornect-auth-gateway:GIT_SHA"
postgrest_image = "ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/doctornect-postgrest:v16.5-rdsca-GIT_SHA"

# --- Existing RDS (console-created; Terraform does NOT create the instance) ---
rds_endpoint            = "example-db.xxxxxxxx.ap-south-1.rds.amazonaws.com"
rds_port                = 5432
rds_db_name             = "doctornect"
rds_security_group_id   = "sg-xxxxxxxx"
rds_instance_identifier = "doctornect-production-rds"

# --- Firebase (JWKS verify only; no Firebase secrets in Terraform) ---
firebase_project_id = "medibond-45fad"

# --- S3 vault buckets (names are not secret; must differ) ---
s3_production_bucket_name = "doctornect-prod-ACCOUNT_ID-ap-south-1"
s3_staging_bucket_name    = "doctornect-ACCOUNT_ID-ap-south-1-an"

# --- Browser origins for gateway CORS and S3 CORS ---
cors_allowed_origins = ["https://doctornect.com", "https://www.doctornect.com", "https://app.doctornect.com"]
