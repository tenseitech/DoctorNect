# =============================================================================
# Cloud Functions secrets — NEVER commit real values.
# =============================================================================
# Production (required): store in Google Secret Manager and bind via secure_config.js
#
#   firebase functions:secrets:set MSG91_AUTHKEY
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#
# Local emulator: copy secret VALUES into `.secret.local` (gitignored), one per line:
#   MSG91_AUTHKEY=...
#   RAZORPAY_KEY_ID=...
# Non-secret flags can stay in this `.env` file (also gitignored).
#
# `.env` is excluded from `firebase deploy` via firebase.json functions.ignore.
# Never put MSG91 / Razorpay secrets in Flutter --dart-define or lib/.

# OTP / App Check
# NEVER enable OTP_TEST_MODE or DEMO_PHONE_* on production project medibond-45fad.
OTP_TEST_MODE=false
# Set false until Play Integrity (Android) + reCAPTCHA (web) are live in Firebase Console.
ENFORCE_OTP_APP_CHECK=true
ENFORCE_ABUSE_APP_CHECK=true
# Ambulance web login HTTP fallback (verifyAmbulanceDriverLoginHttp).
# Keep false until web client ships X-Firebase-AppCheck on that fetch call.
ENFORCE_AMBULANCE_HTTP_APP_CHECK=false
# Extra CORS origins (comma-separated), e.g. http://localhost:5000 for local Flutter web.
AMBULANCE_HTTP_ALLOWED_ORIGINS=

# Demo / store-review accounts (server-only). One mobile per role; OTP is always 000000, no SMS.
# Leave blank in production — functions refuse to boot if set on medibond-45fad.
DEMO_PHONE_PATIENT=
DEMO_PHONE_DOCTOR=
DEMO_PHONE_MEDICAL_STORE=
DEMO_PHONE_LAB=
DEMO_PHONE_AMBULANCE=
# Legacy alias for patient demo number:
GOOGLE_PLAY_REVIEW_PHONE=

# MSG91 (SMS) — server-side only (prefer Secret Manager / .secret.local)
MSG91_AUTHKEY=
# Legacy alias still read by server if MSG91_AUTHKEY unset:
# AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_ID_REGISTRATION=
MSG91_TEMPLATE_ID_LOGIN=
MSG91_TEMPLATE_ID_PASSWORD_RESET=
MSG91_SENDER_ID=DRNECT
MSG91_FROM_EMAIL=no-reply@mail.doctornect.com
MSG91_EMAIL_DOMAIN=mail.doctornect.com

# Admin allow-lists (comma-separated emails — not secrets, but keep out of client)
ACCOUNT_APPROVAL_ADMIN_EMAILS=
BACKFILL_ADMIN_EMAILS=

# Payments (optional — set when Razorpay goes live)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
